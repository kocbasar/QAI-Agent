# Application
APP_NAME=QA Agent
APP_ENV=development

# Database
DATABASE_URL=sqlite:///./qa_agent.db

# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Jira Webhook Security
QA_WEBHOOK_TOKEN=replace-with-a-random-secret


# LLM Gateway
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b

# UI Test Environment
UI_TEST_BASE_URL=https://test.example.com
UI_TEST_USERNAME=your-test-user
UI_TEST_PASSWORD=your-test-password

# Agent Execution
AGENT_MAX_STEPS=4
